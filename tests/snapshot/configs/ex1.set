set version 21.4R3.15
set system host-name ex1
set interfaces ge-0/0/0 ether-options 802.3ad ae0
set interfaces ge-0/0/1 ether-options 802.3ad ae0
set interfaces ge-0/0/1 disable
set interfaces ge-0/0/10 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/10 unit 0 family ethernet-switching vlan members USERS
set interfaces ge-0/0/11 unit 0 family ethernet-switching vlan members 999
set interfaces ge-0/0/47 unit 0 family inet address 10.50.0.0/31
set interfaces ae0 description "uplink LAG"
set interfaces ae0 unit 0 family ethernet-switching interface-mode trunk
set interfaces ae0 unit 0 family ethernet-switching vlan members [ USERS VOICE ]
set interfaces ae0 native-vlan-id 1
set interfaces irb unit 100 family inet address 10.100.0.1/24
set interfaces irb unit 200 family inet address 10.200.0.1/24
set interfaces irb unit 300 family inet address 10.30.0.1/24
set interfaces lo0 unit 0 family inet address 10.5.5.2/32
set vlans USERS vlan-id 100
set vlans USERS l3-interface irb.100
set vlans USERS vxlan vni 10100
set vlans VOICE vlan-id 200
set vlans VOICE l3-interface irb.200
set vlans PRINTERS vlan-id 300
set vlans PRINTERS l3-interface irb.300
set routing-options router-id 10.5.5.2
set routing-options autonomous-system 65300
set protocols bgp group IBGP type internal
set protocols bgp group IBGP local-address 10.5.5.2
set protocols bgp group IBGP family evpn signaling
set protocols bgp group IBGP neighbor 10.5.5.1
